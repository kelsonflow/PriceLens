# App
NODE_ENV=development
APP_ENV=local
WEB_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pricelens

# Google Cloud
GOOGLE_CLOUD_PROJECT=pricelens-506120
GOOGLE_CLOUD_PROJECT_ID=pricelens-506120
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_CLOUD_REGION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=
GCS_PRODUCT_IMAGES_BUCKET=
# Optional. Leave empty when using Vertex AI with Cloud Run service account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_VISION_ENABLED=true
GOOGLE_VISION_API_ENDPOINT=

# Browser-facing API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=https://pricelens-api-44ftuum65a-ew.a.run.app

# Auth
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cache / queue
REDIS_URL=redis://localhost:6379
CLOUD_TASKS_QUEUE=

# Observability
SENTRY_DSN=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shopping providers
ENABLE_MOCK_SHOPPING=false
SERPAPI_API_KEY=
SERPAPI_MAX_RESULTS=20
GOOGLE_SHOPPING_API_KEY=
AFFILIATE_NETWORK_API_KEY=
